axes.titlesize : 12
lines.linewidth : 1.2
axes.linewidth : 0.654
lines.markersize : 10
xtick.labelsize : 10
ytick.labelsize : 10
legend.fontsize : 10
text.usetex: True
# Match the regular font to the default manuscript font
font.family: cmuserif
# mathtext is used for notes
mathtext.fontset : cm
font.size: 7
axes.labelsize: 10
# Ten color colorblind-friendly color cycle from https://arxiv.org/abs/2107.02270
axes.prop_cycle: cycler('color', ["#3f90da", "#ffa90e", "#bd1f01", "#94a4a2", "#832db6", "#a96b59", "#e76300", "#b9ac70", "#717581", "#92dadd", "#3cb44b"])
figure.figsize: 6.13899, 6.13899  # scipost linewidth in inches
figure.dpi: 300
figure.constrained_layout.use: True
